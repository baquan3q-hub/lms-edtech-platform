# Local/staging configuration only. Replace placeholders with that environment's keys.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-local-service-role-key

# Optional: core learning continues when AI is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Direct PostgreSQL URL for a login inheriting ONLY lms_analytics_worker.
# Do not use postgres or service_role. Managed databases should require TLS.
ANALYTICS_DATABASE_URL=
DISABLE_PWA=1
